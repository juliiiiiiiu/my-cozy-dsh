{
  "name": "@local/desk-scene-ui",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Desk Scene skin for the DeepSeek Harness desktop window: client-side CSS and decorations.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
