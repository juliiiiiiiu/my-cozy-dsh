{
  "name": "my-cozy-dsh",
  "version": "1.0.6",
  "license": "MIT",
  "type": "module",
  "description": "Desk Scene skin for the DeepSeek Harness desktop window: client-side CSS and decorations.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:lamp": "node --test tests/lamp-pool.harness.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliiiiiiiu/my-cozy-dsh.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "playwright": "^1.57.0"
  }
}
